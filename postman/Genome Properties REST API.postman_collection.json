                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"HTML content type\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/text\\/html/);",
                  "});",
                  "const body = pm.response.text();",
                  "pm.test(\"Swagger UI\", () => pm.expect(body).to.match(/swagger/i));",
                  "pm.test(\"Relative OpenAPI URL\", () => pm.expect(body).to.include('\"url\": \"openapi.json\"'));",
                  "pm.test(\"Does not double the api prefix\", () => pm.expect(body).to.not.include(\"/api/api/v1/openapi.json\"));"
                ]
              }
            }
          ],
          "request": {
