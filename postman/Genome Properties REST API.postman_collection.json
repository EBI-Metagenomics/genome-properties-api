        {
          "name": "Assign from InterProScan TSV",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON content type\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/application\\/json/);",
                  "});",
                  "const json = pm.response.json();",
                  "const organism = pm.collectionVariables.get(\"organism\");",
                  "const accessions = Object.keys(json);",
                  "pm.test(\"Viewer object\", () => {",
                  "    pm.expect(json).to.be.an(\"object\");",
                  "    pm.expect(accessions).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "const sample = json[accessions[0]];",
                  "pm.test(\"Property record\", () => {",
                  "    pm.expect(sample).to.have.keys(\"property\", \"name\", \"values\", \"steps\");",
                  "    pm.expect(sample.property).to.eql(accessions[0]);",
                  "    pm.expect(sample.name).to.be.a(\"string\");",
                  "    pm.expect(sample.steps).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"Organism column and totals\", () => {",
                  "    pm.expect([\"YES\", \"PARTIAL\", \"NO\"]).to.include(sample.values[organism]);",
                  "    pm.expect(sample.values.TOTAL).to.have.keys(\"YES\", \"PARTIAL\", \"NO\");",
                  "    pm.expect(sample.values.TOTAL[sample.values[organism]]).to.eql(1);",
                  "    [\"YES\", \"PARTIAL\", \"NO\"].filter((label) => label !== sample.values[organism]).forEach((label) => {",
                  "        pm.expect(sample.values.TOTAL[label]).to.eql(0);",
                  "    });",
                  "});",
                  "const withSteps = accessions.map((id) => json[id]).find((row) => row.steps.length > 0);",
                  "pm.test(\"Step record uses viewer field names\", () => {",
                  "    pm.expect(withSteps, \"a property with steps\").to.be.an(\"object\");",
                  "    const step = withSteps.steps[0];",
                  "    pm.expect(step).to.have.keys(\"step\", \"step_name\", \"required\", \"values\");",
                  "    pm.expect(step.step).to.be.a(\"number\");",
                  "    pm.expect(step.step_name).to.be.a(\"string\");",
                  "    pm.expect(step.required).to.be.a(\"number\");",
                  "    pm.expect(step.values[organism]).to.be.a(\"boolean\");",
                  "    pm.expect(step).to.not.have.property(\"stepName\");",
                  "});"
                ]
              }
            }
          ],
