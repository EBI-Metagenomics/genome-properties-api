          "name": "Property detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON content type\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/application\\/json/);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test(\"Detail fields\", () => {",
                  "    pm.expect(json).to.have.keys(",
                  "        \"accession\",",
                  "        \"type\",",
                  "        \"author\",",
                  "        \"description\",",
                  "        \"threshold\",",
                  "        \"comment\",",
                  "        \"literature\",",
                  "        \"databaseLinks\",",
                  "        \"steps\"",
                  "    );",
                  "});",
                  "pm.test(\"Accession matches\", () => pm.expect(json.accession).to.eql(pm.collectionVariables.get(\"accession\")));",
                  "pm.test(\"Scalar fields\", () => {",
                  "    pm.expect(json.type).to.be.a(\"string\").that.is.not.empty;",
                  "    pm.expect(json.author).to.be.a(\"string\");",
                  "    pm.expect(json.description).to.be.a(\"string\").that.is.not.empty;",
                  "    pm.expect(json.threshold).to.be.a(\"number\");",
                  "});",
                  "pm.test(\"Camel-case collections\", () => {",
                  "    pm.expect(json.literature).to.be.an(\"array\");",
                  "    pm.expect(json.databaseLinks).to.be.an(\"array\");",
                  "    pm.expect(json.steps).to.be.an(\"array\");",
                  "    pm.expect(json).to.not.have.property(\"database_links\");",
                  "});",
                  "if (json.literature.length) {",
                  "    pm.test(\"Literature shape\", () => {",
                  "        pm.expect(json.literature[0]).to.include.keys(\"pmid\", \"listOrder\");",
                  "        pm.expect(json.literature[0].pmid).to.be.a(\"number\");",
                  "        pm.expect(json.literature[0]).to.not.have.property(\"list_order\");",
                  "    });",
                  "}",
                  "if (json.databaseLinks.length) {",
                  "    pm.test(\"Database link shape\", () => {",
                  "        pm.expect(json.databaseLinks[0]).to.include.keys(\"dbId\", \"dbLink\");",
                  "        pm.expect(json.databaseLinks[0]).to.not.have.property(\"db_id\");",
                  "    });",
                  "}",
                  "if (json.steps.length) {",
                  "    pm.test(\"Step shape\", () => {",
                  "        const step = json.steps[0];",
                  "        pm.expect(step).to.include.keys(\"stepId\", \"stepNumber\", \"required\", \"evidence\");",
                  "        pm.expect(step.stepNumber).to.be.a(\"number\");",
                  "        pm.expect(step.required).to.be.a(\"number\");",
                  "        pm.expect(step.evidence).to.be.an(\"array\");",
                  "        pm.expect(step).to.not.have.property(\"step_id\");",
                  "        pm.expect(step).to.not.have.property(\"step_number\");",
                  "        if (step.evidence.length) {",
                  "            pm.expect(step.evidence[0]).to.include.keys(\"interproAcc\", \"signatureAcc\");",
                  "            pm.expect(step.evidence[0]).to.not.have.property(\"interpro_acc\");",
                  "        }",
                  "    });",
                  "}"
                ]
              }
