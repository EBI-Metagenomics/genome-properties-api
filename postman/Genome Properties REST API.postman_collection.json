    {
      "name": "Hierarchy",
      "item": [
        {
          "name": "Hierarchy tree",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON content type\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/application\\/json/);",
                  "});",
                  "const json = pm.response.json();",
                  "function assertNode(node, ancestors) {",
                  "    pm.expect(node).to.have.keys(\"accession\", \"description\", \"children\");",
                  "    pm.expect(node.accession).to.be.a(\"string\").that.is.not.empty;",
                  "    pm.expect(node.description).to.be.a(\"string\");",
                  "    pm.expect(node.children).to.be.an(\"array\");",
                  "    pm.expect(ancestors).to.not.include(node.accession);",
                  "    const next = ancestors.concat(node.accession);",
                  "    node.children.forEach((child) => assertNode(child, next));",
                  "}",
                  "pm.test(\"Root accession matches\", () => pm.expect(json.accession).to.eql(pm.collectionVariables.get(\"hierarchyRoot\")));",
                  "pm.test(\"Tree shape\", () => assertNode(json, []));"
                ]
              }
            }
          ],
