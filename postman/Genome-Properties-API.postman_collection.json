{
  "info": {
    "name": "Genome Properties REST API",
    "description": "Smoke tests for GET {{baseUrl}}/health/, /genome-properties/, and /hierarchy/.\n\nImport this file in Postman: Import → Upload Files.\nStart the Django server first: uv run python manage.py runserver",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "accession",
      "value": "GenProp0001"
    },
    {
      "key": "hierarchyRoot",
      "value": "GenProp0065"
    },
    {
      "key": "type",
      "value": "PATHWAY"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"status ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "List by type",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/genome-properties/?type={{type}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test(\"Array of properties\", () => pm.expect(json).to.be.an(\"array\"));",
              "pm.test(\"Has accession\", () => pm.expect(json[0].accession).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Property detail",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/genome-properties/{{accession}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test(\"Accession matches\", () => pm.expect(json.accession).to.eql(pm.collectionVariables.get(\"accession\")));",
              "pm.test(\"Has steps\", () => pm.expect(json.steps).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Hierarchy tree",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/hierarchy/{{hierarchyRoot}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test(\"Root accession matches\", () => pm.expect(json.accession).to.eql(pm.collectionVariables.get(\"hierarchyRoot\")));",
              "pm.test(\"Has children array\", () => pm.expect(json.children).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown property is 404",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/genome-properties/NOPE/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
