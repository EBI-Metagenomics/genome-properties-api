                  "const json = pm.response.json();",
                  "pm.test(\"No GraphQL errors\", () => pm.expect(json.errors).to.be.undefined);",
                  "pm.test(\"Has data\", () => pm.expect(json.data).to.be.an(\"object\"));",
                  "const node = json.data.genomeProperties.edges[0].node;",
                  "pm.test(\"Root accession matches\", () => pm.expect(node.accession).to.eql(pm.collectionVariables.get(\"accession\")));",
                  "pm.test(\"Has step set\", () => pm.expect(node.gpstepSet.edges.length).to.be.above(0));"
                ]
              }
            }
          ]
        }
      ]
