        {
          "name": "GENOME_PROPERTY (detail page)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query GenomePropertyDetail($accession: String!) {\n  genomeProperties(accession: $accession) {\n    edges {\n      node {\n        accession\n        type\n        author\n        description\n        threshold\n        comment\n        gplitrefSet {\n          edges {\n            node {\n              literatureReferencePmid {\n                pmid\n                title\n                author\n                journal\n              }\n              listOrder\n            }\n          }\n        }\n        gpdatabaselinkSet {\n          edges {\n            node {\n              dbId\n              dbLink\n              comment\n              otherParams\n            }\n          }\n        }\n        gpstepSet {\n          edges {\n            node {\n              autoStep\n              stepId\n              stepNumber\n              required\n              gpstepevidencegpSet {\n                edges {\n                  node {\n                    gpAccession {\n                      accession\n                    }\n                  }\n                }\n              }\n              gpstepevidenceiprSet {\n                edges {\n                  node {\n                    interproAcc\n                    signatureAcc\n                    autoIprStep\n                    iprsteptogoSet {\n                      edges {\n                        node {\n                          go {\n                            goId\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n",
                "variables": "{}"
              }
            },
            "url": "{{baseUrl}}/graphql/",
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.body.graphql.variables = JSON.stringify({ accession: pm.collectionVariables.get(\"accession\") }, null, 2);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"No GraphQL errors\", () => pm.expect(json.errors).to.be.undefined);",
                  "pm.test(\"Has data\", () => pm.expect(json.data).to.be.an(\"object\"));",
                  "const node = json.data.genomeProperties.edges[0].node;",
                  "pm.test(\"Detail accession matches\", () => pm.expect(node.accession).to.eql(pm.collectionVariables.get(\"accession\")));",
                  "pm.test(\"Has database links\", () => pm.expect(node.gpdatabaselinkSet.edges.length).to.be.above(0));",
                  "pm.test(\"Has steps\", () => pm.expect(node.gpstepSet.edges.length).to.be.above(0));",
                  "const kegg = node.gpdatabaselinkSet.edges.map(e => e.node).find(n => n.dbId === \"KEGG\");",
                  "pm.test(\"KEGG link is map00400\", () => pm.expect(kegg && kegg.dbLink).to.eql(\"map00400\"));"
                ]
              }
            }
          ]
        },
        {
