                "query": "query GenomePropertiesTypeContains($type_Icontains: String!, $first: Int!) {\n  genomeProperties(type_Icontains: $type_Icontains, first: $first) {\n    edges { node { accession type } }\n  }\n}\n",
                "variables": "{\n  \"type_Icontains\": \"PATH\",\n  \"first\": 10\n}"
              }
            },
            "url": "{{baseUrl}}/graphql/",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"No GraphQL errors\", () => pm.expect(json.errors).to.be.undefined);",
                  "pm.test(\"Has data\", () => pm.expect(json.data).to.be.an(\"object\"));",
