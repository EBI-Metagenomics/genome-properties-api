              "mode": "graphql",
              "graphql": {
                "query": "query GenomePropertiesThresholdGt($threshold_Gt: Int, $first: Int!) {\n  genomeProperties(threshold_Gt: $threshold_Gt, first: $first) {\n    edges { node { accession threshold } }\n  }\n}\n",
                "variables": "{\n  \"threshold_Gt\": 5,\n  \"first\": 5\n}"
              }
