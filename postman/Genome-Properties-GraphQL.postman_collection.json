{
  "info": {
    "name": "Genome Properties GraphQL API",
    "description": "Smoke tests for the GraphQL API at POST {{baseUrl}}/graphql/ (GraphiQL is enabled on GET).\n\nImport this file in Postman: Import \u2192 Upload Files.\nStart the Django server first: python manage.py runserver\n\nSample values come from genome_properties.db (GenProp0001, PATHWAY, GO:0000105, PMID 172079).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "accession",
      "value": "GenProp0001"
    },
    {
      "key": "type",
      "value": "PATHWAY"
    },
    {
      "key": "goId",
      "value": "GO:0000105"
    },
    {
      "key": "pmid",
      "value": "172079"
    },
    {
      "key": "endCursor",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Smoke",
      "item": [
        {
          "name": "GraphiQL UI (GET)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "url": "{{baseUrl}}/graphql/",
            "description": "GraphiQL explorer should load when GraphiQL is enabled."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns HTML\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/html\"));",
                  "pm.test(\"Looks like GraphiQL\", () => pm.expect(pm.response.text()).to.match(/graphiql|GraphQL/i));"
                ]
              }
            }
          ]
        },
        {
          "name": "Introspect Query type",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query IntrospectQuery {\n  __schema {\n    queryType {\n      name\n      fields {\n        name\n      }\n    }\n  }\n}\n",
                "variables": "{}"
              }
            },
            "url": "{{baseUrl}}/graphql/",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"No GraphQL errors\", () => pm.expect(json.errors).to.be.undefined);",
                  "pm.test(\"Has data\", () => pm.expect(json.data).to.be.an(\"object\"));",
                  "const names = json.data.__schema.queryType.fields.map(f => f.name);",
                  "pm.test(\"Exposes genomeProperties\", () => pm.expect(names).to.include(\"genomeProperties\"));",
                  "pm.test(\"Exposes goTerms\", () => pm.expect(names).to.include(\"goTerms\"));",
                  "pm.test(\"Exposes literatureReferences\", () => pm.expect(names).to.include(\"literatureReferences\"));",
                  "pm.test(\"Exposes gpSteps\", () => pm.expect(names).to.include(\"gpSteps\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Genome properties",
      "item": [
        {
          "name": "List first 5 genome properties",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query ListGenomeProperties($first: Int!) {\n  genomeProperties(first: $first) {\n    pageInfo {\n      hasNextPage\n      hasPreviousPage\n      startCursor\n      endCursor\n    }\n    edges {\n      cursor\n      node {\n        accession\n        description\n        type\n        author\n        threshold\n      }\n    }\n  }\n}\n",
                "variables": "{\n  \"first\": 5\n}"
              }
            },
            "url": "{{baseUrl}}/graphql/",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"No GraphQL errors\", () => pm.expect(json.errors).to.be.undefined);",
                  "pm.test(\"Has data\", () => pm.expect(json.data).to.be.an(\"object\"));",
                  "const conn = json.data.genomeProperties;",
                  "pm.test(\"Returns 5 edges\", () => pm.expect(conn.edges).to.have.lengthOf(5));",
                  "pm.test(\"First accession is GenProp0001\", () => pm.expect(conn.edges[0].node.accession).to.eql(\"GenProp0001\"));",
                  "pm.test(\"Has next page\", () => pm.expect(conn.pageInfo.hasNextPage).to.be.true);",
                  "pm.collectionVariables.set(\"endCursor\", conn.pageInfo.endCursor);"
                ]
              }
            }
          ]
        },
        {
          "name": "Paginate after first page",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query PaginateGenomeProperties($first: Int!, $after: String!) {\n  genomeProperties(first: $first, after: $after) {\n    pageInfo { hasNextPage hasPreviousPage }\n    edges { node { accession type } }\n  }\n}\n",
                "variables": "{}"
              }
            },
            "url": "{{baseUrl}}/graphql/",
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const after = pm.collectionVariables.get(\"endCursor\");",
                  "pm.expect(after, \"Run \\\"List first 5 genome properties\\\" first to set endCursor\").to.be.ok;",
                  "pm.request.body.graphql.variables = JSON.stringify({ first: 5, after }, null, 2);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"No GraphQL errors\", () => pm.expect(json.errors).to.be.undefined);",
                  "pm.test(\"Has data\", () => pm.expect(json.data).to.be.an(\"object\"));",
                  "const edges = json.data.genomeProperties.edges;",
                  "pm.test(\"Returns results\", () => pm.expect(edges.length).to.be.above(0));",
                  "pm.test(\"Does not repeat GenProp0001\", () => pm.expect(edges[0].node.accession).to.not.eql(\"GenProp0001\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter by accession",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query GenomePropertyByAccession($accession: String!) {\n  genomeProperties(accession: $accession) {\n    edges {\n      node {\n        accession\n        description\n        type\n        author\n        threshold\n        comment\n      }\n    }\n  }\n}\n",
                "variables": "{}"
              }
            },
            "url": "{{baseUrl}}/graphql/",
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.body.graphql.variables = JSON.stringify({ accession: pm.collectionVariables.get(\"accession\") }, null, 2);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"No GraphQL errors\", () => pm.expect(json.errors).to.be.undefined);",
                  "pm.test(\"Has data\", () => pm.expect(json.data).to.be.an(\"object\"));",
                  "const nodes = json.data.genomeProperties.edges.map(e => e.node);",
                  "pm.test(\"Returns one property\", () => pm.expect(nodes).to.have.lengthOf(1));",
                  "pm.test(\"Accession matches\", () => pm.expect(nodes[0].accession).to.eql(pm.collectionVariables.get(\"accession\")));",
                  "pm.test(\"Description is set\", () => pm.expect(nodes[0].description).to.include(\"Chorismate\"));",
                  "pm.test(\"Type is PATHWAY\", () => pm.expect(nodes[0].type).to.eql(\"PATHWAY\"));"
                ]
              }
            }
          ]
        },
